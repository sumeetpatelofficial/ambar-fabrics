# Copy to .env.local and fill in. Placeholders only; never commit real secrets.
# Public variables (NEXT_PUBLIC_*) are inlined into the browser bundle.

# --- Core ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
MONGODB_URI=mongodb://127.0.0.1:54758/ambar_fabrics?replicaSet=rs0
# Signs session cookies. At least 32 characters; generate with: openssl rand -base64 32. Use a different value per environment.
AUTH_SECRET=replace-with-output-of-openssl-rand-base64-32
# Protects /api/cron/* (the scheduled email worker). Generate with: openssl rand -base64 24
CRON_SECRET=replace-with-a-long-random-string
# Self-hosting only (Vercel needs nothing): the public address of the site, used by sign-in callbacks.
# AUTH_URL=https://your-domain.example
# MONGODB_USERNAME="spthinkwise_db_user"
# MONGODB_PASSWORD="yELnwh8FXIILoxYr"

# --- Google sign-in (optional: the button appears only when both are set) ---
# Create an OAuth client in Google Cloud Console. Authorized redirect URI: <site>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Razorpay (Phase 7) - test-mode keys only during development ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# --- Shipping (Phase 8) - mock adapter is used when empty in development ---
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# Name of the pickup location as created in the Shiprocket panel, and the warehouse PIN code.
SHIPROCKET_PICKUP_LOCATION=
SHIPPING_ORIGIN_PINCODE=
# Token you set in Shiprocket for webhooks (sent as the x-api-key header). 16+ characters.
SHIPROCKET_WEBHOOK_TOKEN=

# --- Email: Resend. In development, empty values print a one-line notice instead of sending. Production refuses to run without them. ---
RESEND_API_KEY=
EMAIL_FROM=

# --- Image storage (Phase 3/9) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


# --- Analytics and monitoring (Phase 11/13) ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=
SENTRY_DSN=
